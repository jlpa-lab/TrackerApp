<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TrackerApp" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.CustomSplash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_purple</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@color/splash_purple</item>
        <item name="android:navigationBarColor">@color/splash_purple</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_system_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.App.CustomSplash</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>

    <style name="Theme.TrackerApp.App" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@color/splash_purple</item>
        <item name="android:navigationBarColor">@color/splash_purple</item>
    </style>
</resources>