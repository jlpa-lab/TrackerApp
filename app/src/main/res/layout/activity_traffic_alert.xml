<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#F6FBF8">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/traffic_back" android:layout_width="28dp" android:layout_height="34dp" android:src="@drawable/ic_phone_back" android:contentDescription="Back"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Traffic Alert" android:textSize="28sp" android:textStyle="bold" android:textColor="#0D1627"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stay one step ahead on the road" android:textColor="#778294"/></LinearLayout></LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="16dp" android:text="Live traffic around you\nCurrent road conditions are shown on the map" android:textSize="18sp" android:textColor="#0D1627" android:background="#FFF1E6"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"><com.google.android.gms.maps.MapView android:id="@+id/traffic_map" android:layout_width="match_parent" android:layout_height="match_parent"/><TextView android:id="@+id/traffic_location_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_margin="16dp" android:padding="12dp" android:text="Enable location to center the traffic map" android:textStyle="bold" android:background="#FFFFFF"/></FrameLayout>
</LinearLayout>
