<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>
<LinearLayout
    android:id="@+id/uninstall_confirm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingHorizontal="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <include layout="@layout/view_uninstall_toolbar" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/ic_confirm_uninstall" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:paddingHorizontal="24dp"
        android:text="@string/uninstall_keep_title"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:fontFamily="@font/inter_regular"
        android:paddingHorizontal="24dp"
        android:text="@string/uninstall_keep_description"
        android:textColor="#4F5765"
        android:textSize="14sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="30dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/keep_app_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_keep_phone_tracker"
        android:fontFamily="@font/inter"
        android:text="@string/keep_phone_tracker"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/continue_uninstall_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_continue_uninstall"
        android:fontFamily="@font/inter"
        android:text="@string/continue_to_uninstall"
        android:textAllCaps="false"
        android:textColor="#08A331"
        android:textSize="14sp" />

<!--    <TextView-->
<!--        android:id="@+id/keep_app_button"-->
<!--        style="@style/UninstallPrimaryButton"-->
<!--        android:text="@string/keep_phone_tracker" />-->

<!--    <TextView-->
<!--        android:id="@+id/continue_uninstall_button"-->
<!--        style="@style/UninstallSecondaryButton"-->
<!--        android:layout_marginTop="12dp"-->
<!--        android:text="@string/continue_to_uninstall" />-->

    <Space
        android:layout_width="match_parent"
        android:layout_height="30dp" />
    </LinearLayout>

    <!-- CHANGE: this container is measured against the full screen width. -->
    <FrameLayout
        android:id="@+id/fr_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/shimmer_ads"
            layout="@layout/layout_shimmer_native_medium" />

    </FrameLayout>
</LinearLayout>
</layout>
