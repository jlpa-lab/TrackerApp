<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <ImageView
            android:id="@+id/profile_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            android:textSize="16sp"
            android:fontFamily="@font/inter_bold"
            android:src="@drawable/ic_back_chevron" />

        <TextView
            android:id="@+id/profile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Profile"
            android:textColor="@color/home_text_dark"
            android:textSize="22sp"
            android:fontFamily="@font/inter_bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Enter Your Name"
            android:textColor="@color/home_phone_locator_text"
            android:fontFamily="@font/inter_bold" />

        <EditText
            android:id="@+id/profile_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_phone_input"
            android:hint="Enter Your Name"
            android:textSize="14sp"
            android:textColorHint="#B0B7C3"
            android:textColor="@color/home_phone_locator_text"
            android:padding="16dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Choose an avatar"
            android:textColor="@color/home_phone_locator_text"
            android:textSize="16sp"
            android:fontFamily="@font/inter_bold" />

        <GridLayout
            android:id="@+id/avatar_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="4"
            android:useDefaultMargins="true">

            <TextView
                android:id="@+id/avatar_1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_connection_icon"
                android:gravity="center"
                android:text="🙂"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/avatar_2"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_connection_icon"
                android:gravity="center"
                android:text="😎"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/avatar_3"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_connection_icon"
                android:gravity="center"
                android:text="🤗"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/avatar_4"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_connection_icon"
                android:gravity="center"
                android:text="🦊"
                android:textSize="28sp" />
        </GridLayout>

        <TextView
            android:id="@+id/profile_continue"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_live_share"
            android:gravity="center"
            android:text="Continue"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/inter_bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:fontFamily="@font/inter_regular"
            android:text="Your profile helps your family recognize you when sharing locations."
            android:textColor="@color/home_text_subtitle"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
