<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/speedometer_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:paddingEnd="8dp"
                android:src="@drawable/ic_back_chevron" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Speedometer"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/speedometer_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="km/h"
                android:textColor="#00A44C" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/speedometer_gauge_host"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/speedometer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Ready"
            android:textColor="#778294" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/speedometer_average"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Average\n0.0"
                android:textColor="#0D1627" />

            <TextView
                android:id="@+id/speedometer_maximum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Maximum\n0.0"
                android:textColor="#0D1627" />

            <TextView
                android:id="@+id/speedometer_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Distance\n0.00"
                android:textColor="#0D1627" />
        </LinearLayout>

        <TextView
            android:id="@+id/speedometer_trip_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Trip stopped"
            android:textColor="#778294" />

        <TextView
            android:id="@+id/speedometer_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#0D1627"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/speedometer_reset"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Reset" />

            <Button
                android:id="@+id/speedometer_start"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Start" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
