<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F6FBF8">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/speedometer_back" android:layout_width="28dp" android:layout_height="32dp" android:src="@drawable/ic_phone_back" android:contentDescription="Back"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Speedometer" android:textSize="28sp" android:textStyle="bold" android:textColor="#0D1627"/><TextView android:id="@+id/speedometer_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="km/h" android:textColor="#00A44C"/></LinearLayout>
  <FrameLayout android:id="@+id/speedometer_gauge_host" android:layout_width="match_parent" android:layout_height="320dp" android:layout_marginTop="16dp"/>
  <TextView android:id="@+id/speedometer_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Ready" android:textColor="#778294"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center">
   <TextView android:id="@+id/speedometer_average" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Average\n0.0" android:textColor="#0D1627"/>
   <TextView android:id="@+id/speedometer_maximum" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Maximum\n0.0" android:textColor="#0D1627"/>
   <TextView android:id="@+id/speedometer_distance" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Distance\n0.00" android:textColor="#0D1627"/>
  </LinearLayout>
  <TextView android:id="@+id/speedometer_trip_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Trip stopped" android:textColor="#778294"/>
  <TextView android:id="@+id/speedometer_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00:00:00" android:textSize="24sp" android:textColor="#0D1627"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal"><Button android:id="@+id/speedometer_reset" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Reset"/><Button android:id="@+id/speedometer_start" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Start"/></LinearLayout>
 </LinearLayout>
</ScrollView>
