<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="HardcodedText,SpUsage">

    <LinearLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native_ads_compact"
        android:orientation="vertical">

        <!-- Block 1: Icon & Headline Group (paddingTop adds space above icon + headline) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/block_icon_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            tools:ignore="MissingClass">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="38dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@color/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="28dp"
                android:textColor="#000000"
                android:textSize="13dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ad_app_icon"
                app:layout_constraintTop_toTopOf="@id/ad_app_icon"
                tools:text="Headline" />

            <TextView
                android:id="@+id/ad_advertiser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#000000"
                android:textSize="13dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/ad_headline"
                app:layout_constraintStart_toStartOf="@id/ad_headline"
                app:layout_constraintTop_toBottomOf="@id/ad_headline"
                tools:text="Ad advertiser" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Block 2: Body -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#000000"
            android:textSize="13dp"
            tools:text="ad body" />

        <!-- Block 3: Media -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp" />

        <!-- Block 4: CTA Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_btn_native_cta"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="16dp"
            tools:text="Install" />
    </LinearLayout>

    <!-- Ad badge: overlay pinned to the card's top-left corner -->
    <TextView
        android:id="@+id/ad_icon"
        android:layout_width="32dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_margin="0dp"
        android:background="@drawable/bg_ad_icon"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="Ad"
        android:textColor="#65717D"
        android:textSize="11dp" />
</com.google.android.gms.ads.nativead.NativeAdView>
