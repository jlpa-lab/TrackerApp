<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/live_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            android:src="@drawable/ic_back_chevron" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_friend_title"
                android:textColor="@color/home_text_dark"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/live_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_friend_subtitle"
                android:textColor="@color/home_text_subtitle"
                android:fontFamily="@font/inter_regular"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/live_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/friend_panel_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="16dp"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/map_layers_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/track_friend_map_layers"
                android:src="@drawable/ic_map_layer2" />

            <LinearLayout
                android:id="@+id/map_layers_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/map_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_map_pill"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"
                    android:gravity="center"
                    android:text="@string/live_normal"
                    android:textSize="12sp"
                    android:textColor="@color/home_phone_locator_text"
                    android:fontFamily="@font/inter_regular" />

                <TextView
                    android:id="@+id/map_satellite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_map_pill"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"
                    android:gravity="center"
                    android:text="@string/live_satellite"
                    android:textSize="12sp"
                    android:textColor="@color/home_phone_locator_text"
                    android:fontFamily="@font/inter_regular" />

                <TextView
                    android:id="@+id/map_terrain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_map_pill"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"
                    android:gravity="center"
                    android:text="@string/live_terrain"
                    android:textSize="12sp"
                    android:textColor="@color/home_phone_locator_text"
                    android:fontFamily="@font/inter_regular"/>

                <TextView
                    android:id="@+id/map_hybrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_map_pill"
                    android:gravity="center"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/live_hybrid"
                    android:textSize="12sp"
                    android:textColor="@color/home_phone_locator_text"
                    android:fontFamily="@font/inter_regular"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/map_zoom_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:src="@drawable/ic_plus" />

            <ImageView
                android:id="@+id/map_zoom_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:src="@drawable/ic_minus" />

            <ImageView
                android:id="@+id/map_focus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/common_focus_on_map"
                android:src="@drawable/ic_location_focus_green" />

            <ImageView
                android:id="@+id/friend_people_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/track_friend_friends"
                android:gravity="center"
                android:src="@drawable/ic_nav_connection" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/friend_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_friend_dialog"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/track_friend_friends"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:id="@+id/friend_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/track_friend_count_zero"
                    android:textColor="@color/home_green_background"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/friend_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/friend_empty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/track_friend_no_accepted"
                android:textColor="@color/home_text_subtitle"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/friend_add_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_phone_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_friend_icon_soft"
                    android:src="@drawable/ic_friend_request" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/track_friend_add"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/friend_received_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_phone_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_friend_icon_soft"
                    android:src="@drawable/ic_friend_bell" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/track_friend_received_requests"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/friend_sent_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_phone_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_friend_icon_soft"
                    android:src="@drawable/ic_friend_plane" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/track_friend_sent_requests"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/self_location_controls"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/live_address"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/share_location"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fr_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/black">

        <include
            android:id="@+id/include_banner"
            layout="@layout/layout_banner_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>
</LinearLayout>



