<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/home_bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
        <TextView android:id="@+id/live_back" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="38sp" android:textColor="@color/home_text_dark"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/live_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Track Friend" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/home_text_dark"/>
            <TextView android:id="@+id/live_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your people, connected safely" android:textSize="17sp" android:textColor="@color/home_text_subtitle"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/live_map" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|top" android:layout_margin="16dp" android:gravity="end" android:orientation="vertical">
            <ImageView android:id="@+id/map_layers_button" android:layout_width="64dp" android:layout_height="64dp" android:padding="16dp" android:src="@drawable/ic_map_layers" android:contentDescription="Map layers" android:background="@drawable/bg_map_control"/>
            <LinearLayout android:id="@+id/map_layers_menu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="8dp">
                <TextView android:id="@+id/map_normal" android:layout_width="96dp" android:layout_height="wrap_content" android:gravity="center" android:text="Normal" android:textStyle="bold" android:padding="10dp" android:background="@drawable/bg_map_pill"/>
                <TextView android:id="@+id/map_satellite" android:layout_width="96dp" android:layout_height="wrap_content" android:gravity="center" android:text="Satellite" android:padding="10dp" android:layout_marginTop="4dp" android:background="@drawable/bg_map_pill"/>
                <TextView android:id="@+id/map_terrain" android:layout_width="96dp" android:layout_height="wrap_content" android:gravity="center" android:text="Terrain" android:padding="10dp" android:layout_marginTop="4dp" android:background="@drawable/bg_map_pill"/>
                <TextView android:id="@+id/map_hybrid" android:layout_width="96dp" android:layout_height="wrap_content" android:gravity="center" android:text="Hybrid" android:padding="10dp" android:layout_marginTop="4dp" android:background="@drawable/bg_map_pill"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|bottom" android:layout_margin="16dp" android:orientation="vertical">
            <TextView android:id="@+id/map_zoom_in" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:text="+" android:textSize="28sp" android:background="@drawable/bg_map_control"/>
            <TextView android:id="@+id/map_zoom_out" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center" android:text="−" android:textSize="28sp" android:background="@drawable/bg_map_control"/>
            <ImageView android:id="@+id/map_focus" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginTop="8dp" android:padding="16dp" android:src="@drawable/ic_location_focus_green" android:contentDescription="Focus on map" android:background="@drawable/bg_map_control"/>
            <ImageView android:id="@+id/friend_people_button" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center" android:padding="18dp" android:src="@drawable/ic_people_group" android:contentDescription="Friends" android:background="@drawable/bg_map_control"/>
        </LinearLayout>
    </FrameLayout>
    <View android:id="@+id/self_location_controls" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <TextView android:id="@+id/live_address" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <TextView android:id="@+id/share_location" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/friend_empty_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="gone" android:background="@drawable/bg_tool_list">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Friends" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/home_text_dark"/>
            <TextView android:id="@+id/friend_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 friends" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/home_green_button_text"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/friend_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <TextView android:id="@+id/friend_empty_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No friends are sharing their location yet." android:textSize="14sp" android:textColor="@color/home_text_subtitle"/>
        <TextView android:id="@+id/friend_add_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:padding="14dp" android:text="Add friend                 ›" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/home_text_dark" android:background="@drawable/bg_phone_input"/>
    </LinearLayout>
</LinearLayout>
