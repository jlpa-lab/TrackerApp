<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_permission_dialog">

    <ImageView
        android:id="@+id/exit_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/exit_app_icon_description"
        android:padding="18dp"
        android:background="@drawable/bg_permission_icon"
        android:src="@drawable/ic_exit_app" />

    <TextView
        android:id="@+id/exit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:text="@string/exit_app_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/exit_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingExtra="3dp"
        android:text="@string/exit_app_message"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/exit_primary"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_bold"
        android:text="@string/exit_app_yes"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:background="@drawable/bg_permission_primary" />

    <TextView
        android:id="@+id/exit_secondary"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_bold"
        android:text="@string/exit_app_no"
        android:textColor="@color/app_color"
        android:textSize="16sp"
        android:background="@drawable/bg_permission_secondary" />
</LinearLayout>
