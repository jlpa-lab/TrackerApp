<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/home_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/live_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            android:src="@drawable/ic_back_chevron" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Location"
                android:textColor="@color/home_text_dark"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/live_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Stay close, wherever you are"
                android:textColor="@color/home_text_subtitle"
                android:fontFamily="@font/inter_regular"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/live_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="16dp"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/map_layers_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Map layers"
                android:src="@drawable/ic_map_layer2" />

            <LinearLayout
                android:id="@+id/map_layers_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/map_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_map_pill"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"
                    android:text="Normal"
                    android:textSize="12sp"
                    android:textColor="@color/home_phone_locator_text"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:id="@+id/map_satellite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_map_pill"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"
                    android:text="Satellite"
                    android:textSize="12sp"
                    android:textColor="@color/home_phone_locator_text"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:id="@+id/map_terrain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_map_pill"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"
                    android:text="Terrain"
                    android:textSize="12sp"
                    android:textColor="@color/home_phone_locator_text"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:id="@+id/map_hybrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_map_pill"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="10dp"
                    android:text="Hybrid"
                    android:textSize="12sp"
                    android:textColor="@color/home_phone_locator_text"
                    android:fontFamily="@font/inter_bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/map_friends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:contentDescription="Friend requests"
                android:src="@drawable/ic_nav_connection"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/map_zoom_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:src="@drawable/ic_plus"/>

            <ImageView
                android:id="@+id/map_zoom_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_minus"
                android:gravity="center" />

            <ImageView
                android:id="@+id/map_focus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:contentDescription="Focus on my location"
                android:src="@drawable/ic_location_focus_green" />

        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/self_location_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/live_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Waiting for your location…"
            android:textColor="@color/home_text_subtitle"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/share_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_share"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_location_pin_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/inter_bold"
                android:text="Share Location Address"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
