<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/home_bg"
    android:clipChildren="false"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:clipToPadding="false">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/phone_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/common_back"
            android:focusable="true"
            android:paddingEnd="8dp"
            android:src="@drawable/ic_back_chevron" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/phone_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_locator_title"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/phone_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_locator_subtitle"
                android:textColor="@color/home_text_subtitle"
                android:fontFamily="@font/inter_regular"
                android:textSize="13sp" />
        </LinearLayout>
        </LinearLayout>
    <!-- ================= STATE 1: ENTER NUMBER ================= -->
    <LinearLayout
        android:id="@+id/phone_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:padding="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@drawable/bg_phone_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_enter_number_title"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="16sp"
                android:fontFamily="@font/inter_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/phone_number_label"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="12sp" />

            <!-- Input row: turns green when EditText is focused -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_phone_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="12dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/country_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_phone_chevron_down"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="12dp"
                    android:text="🇻🇳 +84"
                    android:textColor="@color/home_text_dark"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_bold" />

                <EditText
                    android:id="@+id/phone_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="@null"
                    android:background="@null"
                    android:hint="@string/phone_number_hint"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:selectAllOnFocus="false"
                    android:textColorHighlight="@android:color/transparent"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="12dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/home_phone_locator_text"
                    android:textColorHint="@color/home_text_subtitle"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/phone_contacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/phone_contacts"
                    android:src="@drawable/ic_phone_contacts" />

                <ImageView
                    android:id="@+id/phone_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/common_clear"
                    android:paddingVertical="6dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="3dp"
                    android:src="@drawable/ic_phone_clear"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Search button -->
            <LinearLayout
                android:id="@+id/phone_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_live_share"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_phone_search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/common_search"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_phone_tip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_phone_info"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/phone_full_number_hint"
                android:textColor="@color/home_green_title"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= STATE 2: NO RESULTS ================= -->
    <LinearLayout
        android:id="@+id/phone_result"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Read-only number row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_phone_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/result_flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇻🇳"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/result_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="+84"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_phone_divider" />

            <TextView
                android:id="@+id/result_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:src="@drawable/ic_phone_no_result" />

        <TextView
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/phone_no_results"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/home_phone_locator_text"
            android:textSize="18sp"
            android:fontFamily="@font/inter_bold" />

        <TextView
            android:id="@+id/result_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/home_text_subtitle"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/phone_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_live_share"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/common_retry"
            android:textColor="@color/white"
            android:textSize="15sp"
           android:fontFamily="@font/inter_bold"/>

        <TextView
            android:id="@+id/phone_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_phone_cancel"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/common_cancel"
            android:textColor="@color/home_text_subtitle"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_phone_tip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_phone_tip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/phone_number_check_hint"
                android:textColor="@color/home_green_title"
                android:fontFamily="@font/inter_regular"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= STATE 3: DETAILS ================= -->
    <LinearLayout
        android:id="@+id/phone_details"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone">

        <!-- Profile card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_phone_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/details_avatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_phone_no_result_icon"
                android:contentDescription="@string/phone_avatar"
                android:padding="22dp"
                android:src="@drawable/ic_phone_person" />

            <TextView
                android:id="@+id/details_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/common_unknown"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold" />

            <!-- Location pill (swap background to bg_phone_pill_known for known contacts) -->
            <LinearLayout
                android:id="@+id/details_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_phone_pill_unknown"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/details_pin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_phone_pin"/>

                <TextView
                    android:id="@+id/details_country"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Vietnam"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="#787E8D"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Number row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_phone_number_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_phone_call"/>

                <TextView
                    android:id="@+id/details_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123456789"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_phone_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_actions"
                android:textColor="@color/home_text_subtitle"
                android:textSize="13sp"
                android:fontFamily="@font/inter_semibold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Call -->
                <LinearLayout
                    android:id="@+id/details_call"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_call"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_phone_circle_green"
                        app:tint="@color/white"
                        android:src="@drawable/ic_phone_call"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/common_call"
                        android:textColor="@color/home_phone_locator_text"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <!-- SMS -->
                <LinearLayout
                    android:id="@+id/details_sms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_sms"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_phone_circle_peach"
                        android:src="@drawable/ic_phone_sms" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/phone_sms"
                        android:textColor="@color/home_phone_locator_text"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <!-- Navigate (only shown when the contact is known) -->
                <LinearLayout
                    android:id="@+id/details_navigate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_navigate"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_phone_circle_blue"
                        android:src="@drawable/ic_phone_navigate" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/phone_navigate"
                        android:textColor="@color/home_phone_locator_text"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_semibold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <FrameLayout
        android:id="@+id/country_picker_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:id="@+id/country_picker_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#520A101F" />

        <include
            android:id="@+id/country_picker_sheet"
            layout="@layout/dialog_country_picker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/layout_native_all" />

</LinearLayout>
