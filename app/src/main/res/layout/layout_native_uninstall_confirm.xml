<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_native_ads" android:paddingTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="8dp">
            <ImageView android:id="@+id/ad_app_icon" android:layout_width="35dp" android:layout_height="35dp" android:contentDescription="@null" />
            <TextView android:id="@+id/ad_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:background="@drawable/bg_ad_icon" android:paddingHorizontal="5dp" android:paddingVertical="2dp" android:text="Ad" android:textColor="#ffffff" android:textSize="11dp" />
            <TextView android:id="@+id/ad_headline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:textColor="#000000" android:textSize="14dp" android:textStyle="bold" tools:text="Headline" />
        </LinearLayout>
        <TextView android:id="@+id/ad_advertiser" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:layout_marginTop="2dp" android:textColor="#000000" android:textSize="13dp" android:textStyle="bold" />
        <TextView android:id="@+id/ad_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp" android:textColor="#000000" android:textSize="13dp" tools:text="Ad body" />
        <com.google.android.gms.ads.nativead.MediaView android:id="@+id/ad_media" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginHorizontal="8dp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/ad_call_to_action" android:layout_width="match_parent" android:layout_height="40dp" android:layout_margin="16dp" android:background="@drawable/bg_btn_native_cta" android:textAllCaps="false" android:textColor="#ffffff" android:textSize="16dp" tools:text="Install" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
