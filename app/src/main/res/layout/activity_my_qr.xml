<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/home_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="20dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/my_qr_back" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="@color/home_text_dark" android:textSize="38sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My QR" android:textColor="@color/home_text_dark" android:textSize="30sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Your people, connected safely" android:textColor="@color/home_text_subtitle" android:textSize="17sp"/></LinearLayout></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_tool_list" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your QR Code" android:textColor="@color/home_text_dark" android:textSize="23sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Let your friend scan this to connect with you." android:textColor="@color/home_text_subtitle" android:textSize="16sp"/><ImageView android:id="@+id/my_qr_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:adjustViewBounds="true" android:contentDescription="Your connection QR code" android:scaleType="fitCenter"/><TextView android:id="@+id/my_qr_code_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/></LinearLayout>
        <TextView android:id="@+id/my_qr_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:background="@drawable/bg_qr_status" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:text="●  Location sharing is off" android:textColor="@color/home_green_button_text" android:textSize="15sp"/>
        <TextView android:id="@+id/my_qr_share" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_live_share" android:gravity="center" android:padding="16dp" android:text="♧  Share QR Code" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:drawableStart="@drawable/ic_done" android:drawablePadding="12dp" android:gravity="center_vertical" android:text="Location sharing starts only after a friend request is accepted." android:textColor="@color/home_text_subtitle" android:textSize="15sp"/>
    </LinearLayout>
</ScrollView>
