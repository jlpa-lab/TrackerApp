<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/friend_request_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/my_qr_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_back_chevron" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="My QR"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Your people, connected safely"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="678dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_tool_list"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Your QR Code"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_regular"
                android:text="Let your friend scan this to track you in real - time."
                android:textColor="@color/home_text_subtitle"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/my_qr_image"
                android:layout_width="420dp"
                android:layout_height="420dp"
                android:layout_marginTop="34dp"
                android:contentDescription="Your invite QR code"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/my_qr_code_text"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/my_qr_status"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_qr_status"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="●  Live Location Sharing Active"
            android:textColor="@color/app_color"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/my_qr_share"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_live_share"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌯"
                android:textColor="@color/white"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/inter_bold"
                android:text="Share QR Code"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Privacy"
                android:src="@drawable/ic_privacy_shield" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:text="Location sharing starts only after a friend request is accepted."
                android:textColor="@color/home_text_subtitle"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

