<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/friend_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_back_chevron" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Friend Requests"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="22sp"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See who wants to connect with you"
                    android:textColor="@color/home_text_subtitle"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/friend_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tool_list">

            <TextView
                android:id="@+id/friend_add"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="8dp"
                android:text="Add Friend"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/friend_received"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="8dp"
                android:text="Received"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/friend_sent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="8dp"
                android:text="Sent"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/add_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_tool_list"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Make a connection"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="18sp"
               android:fontFamily="@font/inter_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Invite a friend. Location sharing stays under your control."
                android:textColor="@color/home_text_subtitle"
                android:fontFamily="@font/inter_regular"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Your invite code"
                android:textColor="@color/home_text_subtitle"
                android:fontFamily="@font/inter_regular"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/my_invite_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_connection_icon"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:padding="12dp"
                android:text="--------"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="24sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/share_invite_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_live_share"
                android:gravity="center"
                android:padding="13dp"
                android:text="Share invitation"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/show_my_qr_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_phone_input"
                android:gravity="center"
                android:padding="13dp"
                android:text="Show my QR code"
                android:textColor="@color/home_green_button_text"
                android:textSize="14sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/scan_friend_qr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_connection_icon"
                android:padding="16dp"
                android:text="▦  Scan a friend's QR code     ›"
                android:textColor="@color/home_green_button_text"
                android:textSize="16sp"
                android:fontFamily="@font/inter_bold" />

            <EditText
                android:id="@+id/friend_code_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_phone_input"
                android:hint="Enter a friend's invite code"
                android:textColorHint="@color/home_text_subtitle"
                android:inputType="textCapCharacters"
                android:textSize="16sp"
                android:padding="14dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/friend_connect_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_live_share"
                android:gravity="center"
                android:padding="13dp"
                android:text="Send friend request"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/connection_backend_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Invite codes and QR previews work on this device. Sending/receiving requests and live sharing need the connection service to be configured."
                android:textColor="@color/home_text_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/received_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_tool_list"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Received invitations"
                android:textColor="@color/home_text_dark"
                android:textSize="18sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="22dp"
                android:text="No pending invitations yet. When someone sends you a request, it will appear here."
                android:textColor="@color/home_text_subtitle"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sent_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_tool_list"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sent invitations"
                android:textColor="@color/home_text_dark"
                android:textSize="18sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="22dp"
                android:text="You haven’t sent any invitations yet."
                android:textColor="@color/home_text_subtitle"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
