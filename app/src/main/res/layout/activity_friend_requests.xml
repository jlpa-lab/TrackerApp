<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:fitsSystemWindows="true" android:background="@color/home_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="24dp" android:paddingBottom="24dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/friend_back" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="32sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Friend Requests" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/home_text_dark"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See who wants to connect with you" android:textSize="18sp" android:textColor="@color/home_text_subtitle"/></LinearLayout></LinearLayout>
<LinearLayout android:id="@+id/friend_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_tool_list"><TextView android:id="@+id/friend_add" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="16dp" android:text="Add Friend" android:textSize="16sp"/><TextView android:id="@+id/friend_received" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="16dp" android:text="Received" android:textSize="16sp"/><TextView android:id="@+id/friend_sent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="16dp" android:text="Sent" android:textSize="16sp"/></LinearLayout>
<LinearLayout android:id="@+id/add_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_tool_list"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Make a connection" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/home_text_dark"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Invite a friend. Location sharing stays under your control." android:textSize="14sp" android:textColor="@color/home_text_subtitle"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Your invite code" android:textSize="14sp" android:textColor="@color/home_text_subtitle"/><TextView android:id="@+id/my_invite_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:padding="14dp" android:text="--------" android:textSize="24sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="@color/home_text_dark" android:background="@drawable/bg_connection_icon"/><TextView android:id="@+id/share_invite_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:padding="13dp" android:text="Share invitation" android:textSize="15sp" android:textStyle="bold" android:textColor="@android:color/white" android:background="@drawable/bg_live_share"/><TextView android:id="@+id/show_my_qr_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center" android:padding="13dp" android:text="Show my QR code" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/home_green_button_text" android:background="@drawable/bg_phone_input"/><TextView android:id="@+id/scan_friend_qr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:text="▦  Scan a friend's QR code     ›" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/home_green_button_text" android:background="@drawable/bg_connection_icon"/><EditText android:id="@+id/friend_code_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Enter a friend's invite code" android:singleLine="true" android:inputType="textCapCharacters" android:padding="14dp" android:background="@drawable/bg_phone_input"/><TextView android:id="@+id/friend_connect_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center" android:padding="13dp" android:text="Send friend request" android:textSize="15sp" android:textStyle="bold" android:textColor="@android:color/white" android:background="@drawable/bg_live_share"/><TextView android:id="@+id/connection_backend_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Invite codes and QR previews work on this device. Sending/receiving requests and live sharing need the connection service to be configured." android:textSize="12sp" android:textColor="@color/home_text_subtitle"/></LinearLayout>
<LinearLayout android:id="@+id/received_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="20dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/bg_tool_list"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Received invitations" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/home_text_dark"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:padding="22dp" android:text="No pending invitations yet. When someone sends you a request, it will appear here." android:textSize="14sp" android:textColor="@color/home_text_subtitle"/></LinearLayout>
<LinearLayout android:id="@+id/sent_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="20dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/bg_tool_list"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sent invitations" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/home_text_dark"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:padding="22dp" android:text="You haven’t sent any invitations yet." android:textSize="14sp" android:textColor="@color/home_text_subtitle"/></LinearLayout>
</LinearLayout></ScrollView>
