<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/home_bg" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="20dp" android:paddingBottom="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connection" android:textColor="@color/home_text_dark" android:textSize="30sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Stay connected with your people" android:textColor="@color/home_text_subtitle" android:textSize="17sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_tool_list" android:orientation="vertical" android:padding="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Location sharing" android:textColor="@color/home_text_dark" android:textSize="20sp" android:textStyle="bold" /><Switch android:id="@+id/connection_location_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Location sharing" /></LinearLayout><TextView android:id="@+id/connection_location_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Location sharing is off" android:textColor="@color/home_text_subtitle" android:textSize="15sp" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_tool_list" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
<LinearLayout android:id="@+id/connection_share_invite" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="16dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Add connection" android:textColor="@color/home_text_dark" android:textSize="19sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_text_subtitle" android:textSize="32sp" /></LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6ECE8" /><LinearLayout android:id="@+id/connection_show_qr" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="16dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="My QR code" android:textColor="@color/home_text_dark" android:textSize="19sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_text_subtitle" android:textSize="32sp" /></LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6ECE8" /><LinearLayout android:id="@+id/connection_manage_requests" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="16dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Connection requests" android:textColor="@color/home_text_dark" android:textSize="19sp" android:textStyle="bold" /><TextView android:id="@+id/connection_request_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_connection_icon" android:gravity="center" android:minWidth="36dp" android:padding="6dp" android:textColor="@color/home_green_button_text" android:textSize="16sp" android:visibility="gone" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/home_text_subtitle" android:textSize="32sp" /></LinearLayout></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Only approved connections can see your location." android:textColor="@color/home_text_subtitle" android:textSize="14sp" />
</LinearLayout></ScrollView>
