<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/track_friend_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:contentDescription="@string/common_back"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_back_chevron"  />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/track_friend_title"
                        android:textColor="@color/home_phone_locator_text"
                        android:textSize="22sp"
                        android:fontFamily="@font/inter_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/track_friend_subtitle"
                        android:textColor="@color/home_text_subtitle"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_tool_list"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="◎"
                    android:textColor="@color/home_green_button_text"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/track_friend_empty_title"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/track_friend_empty_description"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/track_friend_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_live_share"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/track_friend_connect"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:id="@+id/track_friend_view_map"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_phone_input"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/track_friend_view_locations"
                    android:textColor="@color/home_green_button_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_bold"  />

                <TextView
                    android:id="@+id/track_friend_requests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_phone_input"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/track_friend_view_requests"
                    android:textColor="@color/home_green_button_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_phone_tip"
                android:padding="14dp"
                android:text="@string/track_friend_inactive_notice"
                android:textColor="@color/home_text_subtitle"
                android:fontFamily="@font/inter_regular"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>



