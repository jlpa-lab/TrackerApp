<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/rate_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rate_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/rate_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />

        <ImageView
            android:id="@+id/rate_illustration"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="5dp"
            android:adjustViewBounds="true"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/rate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:textColor="@color/rate_dialog_title"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/rate_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:paddingTop="12dp"
            android:textColor="@color/rate_dialog_subtitle"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/rate_stars"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <EditText
            android:id="@+id/rate_feedback"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            android:gravity="top"
            android:hint="Write your feedback here..."
            android:inputType="textMultiLine"
            android:maxLength="500"
            android:minLines="5"
            android:padding="12dp"
            android:textColor="@color/rate_dialog_subtitle"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rate_count"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/poppins_regular"
            android:gravity="end|center_vertical"
            android:text="0/500"
            android:textColor="#7885A0"
            android:textSize="10sp"
            android:visibility="gone" />


        <TextView
            android:id="@+id/rate_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_live_share"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="submit"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rate_later"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:paddingTop="14dp"
            android:text="Maybe later"
            android:textColor="@color/home_green_background"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
