<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingVertical="5dp">

        <ImageView
            android:id="@+id/area_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:paddingEnd="8dp"
            android:src="@drawable/ic_phone_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Area Codes"
            android:textColor="@color/home_phone_locator_text"
            android:textSize="22sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Map icon -->
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Area code map"
            android:scaleType="fitCenter"
            android:src="@drawable/tool_area_codes" />

        <!-- Text section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Know where a number is from"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter_regular"
                android:text="Look up phone area codes by region"
                android:textColor="@color/home_text_subtitle"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_area_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/ic_search"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="search"
            android:src="@drawable/ic_area_search" />

        <EditText
            android:id="@+id/area_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="@null"
            android:background="@null"
            android:fontFamily="@font/inter_regular"
            android:hint="Search city or area code"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:selectAllOnFocus="false"
            android:textColor="@color/home_phone_locator_text"
            android:textColorHighlight="@android:color/transparent"
            android:textColorHint="@color/home_text_subtitle"
            android:textSize="12sp" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/area_location_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_area_location"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_locate_fixed" />

        <TextView
            android:id="@+id/area_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_semibold"
            android:text="Use my location"
            android:textColor="@color/home_green_background"
            android:textSize="12sp" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/area_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_regular"
            android:text="Popular area codes"
            android:textColor="@color/home_text_subtitle"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/area_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="0 regions"
            android:textColor="@color/home_phone_locator_text"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/area_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

    </FrameLayout>

    <!-- Hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_area_tip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_phone_call"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:id="@+id/area_hint_text"
            android:text="Dial +91, followed by the area code and the 7 digit local number for local calls."
            android:textColor="@color/home_text_subtitle"
            android:textSize="10sp"
            android:fontFamily="@font/inter_regular"/>
    </LinearLayout>
</LinearLayout>
