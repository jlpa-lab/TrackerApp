<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#F7FBF8">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/area_back" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_phone_back" android:contentDescription="Back"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Area Codes" android:textSize="24sp" android:textStyle="bold" android:textColor="#0F172A"/><TextView android:id="@+id/area_country" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#08A349"/></LinearLayout>
 <EditText android:id="@+id/area_query" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:hint="Search city or area code" android:singleLine="true" android:imeOptions="actionSearch"/>
 <LinearLayout android:id="@+id/area_location_container" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center"><TextView android:id="@+id/area_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Use my location" android:textStyle="bold" android:textColor="#08A349"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"><TextView android:id="@+id/area_section_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Popular area codes" android:textColor="#778294"/><TextView android:id="@+id/area_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 regions" android:textStyle="bold"/></LinearLayout>
 <FrameLayout android:id="@+id/area_results" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"/>
</LinearLayout>
