<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F6FBF8"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/create_zone_back" android:layout_width="28dp" android:layout_height="34dp" android:src="@drawable/ic_phone_back" android:contentDescription="Back"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Add or edit zone" android:textSize="24sp" android:textStyle="bold"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal"><EditText android:id="@+id/create_zone_search" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:hint="Search location or address" android:singleLine="true" android:imeOptions="actionSearch"/><Button android:id="@+id/create_zone_search_button" android:layout_width="wrap_content" android:layout_height="50dp" android:text="Search"/></LinearLayout>
 <FrameLayout android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="10dp"><com.google.android.gms.maps.MapView android:id="@+id/create_zone_map" android:layout_width="match_parent" android:layout_height="match_parent"/><Button android:id="@+id/create_zone_locate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:text="Locate"/><TextView android:id="@+id/create_zone_location_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:padding="8dp" android:text="Allow location or search for a place" android:background="#FFFFFF"/></FrameLayout>
 <TextView android:id="@+id/create_zone_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Move the map to set your zone location"/>
 <EditText android:id="@+id/create_zone_name" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:hint="e.g. Home, School, Office" android:singleLine="true"/>
 <TextView android:id="@+id/create_zone_radius_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="500 m" android:textColor="#00A44C"/><SeekBar android:id="@+id/create_zone_radius" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="9" android:progress="4"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/create_zone_safe" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Safe Zone"/><Button android:id="@+id/create_zone_danger" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Danger Zone"/></LinearLayout>
 <CheckBox android:id="@+id/create_zone_enter" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alert when someone enters" android:checked="true"/><CheckBox android:id="@+id/create_zone_exit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alert when someone leaves" android:checked="true"/>
 <Button android:id="@+id/create_zone_save" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Save Zone"/>
 </LinearLayout></ScrollView>
