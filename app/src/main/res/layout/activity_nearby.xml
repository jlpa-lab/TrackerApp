<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nearby_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/nearby_back"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:clickable="true"
                    android:contentDescription="Back"
                    android:focusable="true"
                    android:src="@drawable/ic_phone_back" />
                <TextView
                    android:id="@+id/nearby_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="Nearby"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="22sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/nearby_header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Find the places you need, close by"
                android:textColor="@color/home_text_subtitle"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nearby_search_container"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_nearby_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/nearby_search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_nearby_search" />
            <EditText
                android:id="@+id/nearby_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/inter_regular"
                android:hint="Search places or an address"
                android:imeOptions="actionSearch"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/home_phone_locator_text"
                android:textColorHint="@color/home_text_subtitle"
                android:textSize="13sp" />
            <ImageView
                android:id="@+id/nearby_clear"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:contentDescription="Clear search"
                android:focusable="true"
                android:padding="3dp"
                android:src="@drawable/ic_nearby_close"
                android:visibility="gone" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/nearby_chips"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawableStart="@drawable/ic_nearby_coffee"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/home_text_subtitle"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Coffee"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@drawable/ic_nearby_food"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/home_text_subtitle"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Food"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@drawable/ic_nearby_gas"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/home_text_subtitle"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Gas"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:drawableStart="@drawable/ic_nearby_more"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/home_text_subtitle"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="More"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/nearby_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:text="Coffee near you"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/nearby_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/home_green_title"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nearby_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/nearby_state_panel"
            android:layout_width="match_parent"
            android:layout_height="262dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_nearby_empty"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/nearby_state_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="No places"
                android:scaleType="centerInside"
                android:src="@drawable/ic_area_no_result" />
            <TextView
                android:id="@+id/nearby_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/nearby_state_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/home_text_subtitle"
                android:textSize="13sp" />
            <ProgressBar
                android:id="@+id/nearby_loading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/nearby_state_action"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_nearby_action"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/nearby_distance_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_regular"
            android:text="Distances are measured from your location."
            android:textColor="@color/home_text_subtitle"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
