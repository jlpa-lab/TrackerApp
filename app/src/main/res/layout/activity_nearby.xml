<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F6FBF8"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/nearby_back" android:layout_width="28dp" android:layout_height="34dp" android:src="@drawable/ic_phone_back" android:contentDescription="Back"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Nearby" android:textSize="25sp" android:textStyle="bold"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:gravity="center_vertical"><EditText android:id="@+id/nearby_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="Search places or an address" android:singleLine="true" android:imeOptions="actionSearch"/><TextView android:id="@+id/nearby_clear" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="×" android:textSize="23sp"/></LinearLayout>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none"><LinearLayout android:id="@+id/nearby_chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:layout_width="wrap_content" android:layout_height="48dp" android:text="Coffee"/><Button android:layout_width="wrap_content" android:layout_height="48dp" android:text="Food"/><Button android:layout_width="wrap_content" android:layout_height="48dp" android:text="Gas"/><Button android:layout_width="wrap_content" android:layout_height="48dp" android:text="More"/></LinearLayout></HorizontalScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"><TextView android:id="@+id/nearby_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Coffee near you" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/nearby_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#00A44C"/></LinearLayout>
 <LinearLayout android:id="@+id/nearby_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 <LinearLayout android:id="@+id/nearby_state_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp"><TextView android:id="@+id/nearby_state_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌖" android:textSize="30sp"/><TextView android:id="@+id/nearby_state_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Finding places nearby…" android:textStyle="bold"/><TextView android:id="@+id/nearby_state_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Using your location to find nearby matches."/><ProgressBar android:id="@+id/nearby_loading" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/nearby_state_action" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone"/></LinearLayout>
 </LinearLayout></ScrollView>
