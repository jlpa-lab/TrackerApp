<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F7FBF8">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/stopwatch_back" android:layout_width="28dp" android:layout_height="32dp" android:src="@drawable/ic_phone_back" android:contentDescription="Back"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Stopwatch" android:textSize="28sp" android:textStyle="bold" android:textColor="#0D1627"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" android:gravity="center" android:padding="28dp" android:background="#F3EFFF">
   <TextView android:id="@+id/stopwatch_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ready to start" android:textColor="#00A44C"/>
   <TextView android:id="@+id/stopwatch_elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00.00" android:textSize="52sp" android:textColor="#0D1627"/>
   <TextView android:id="@+id/stopwatch_current_lap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00.00" android:textColor="#0D1627"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal"><Button android:id="@+id/stopwatch_left" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Lap"/><Button android:id="@+id/stopwatch_main" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Start"/></LinearLayout>
  <TextView android:id="@+id/stopwatch_lap_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="0 completed" android:textColor="#778294"/>
  <LinearLayout android:id="@+id/stopwatch_lap_list" android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="16dp"/>
 </LinearLayout>
</ScrollView>
