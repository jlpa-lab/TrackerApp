<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">


            <ImageView
                android:id="@+id/stopwatch_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:paddingEnd="8dp"
                android:src="@drawable/ic_phone_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Stopwatch"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Map icon -->
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Area code map"
                android:scaleType="fitCenter"
                android:src="@drawable/tool_stopwatch" />

            <!-- Text section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Make every second count"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Precise timing with easy lap tracking"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="11sp" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:background="#F1ECFC"
            android:gravity="center"
            android:paddingTop="35dp"
            android:paddingBottom="35dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/stopwatch_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:padding="5dp">

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/bg_scan_qr_circle"
                    app:tint="@color/home_text_subtitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="ready to start"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/stopwatch_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00.00"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/stopwatch_current_lap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:fontFamily="@font/inter_regular"
                android:text="MINUTES : SECONDS . HUNDREDTHS"
                android:textColor="@color/home_text_subtitle" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DCD5EE"
                android:layout_marginVertical="16dp"
                android:layout_marginHorizontal="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp">

                <TextView
                    android:id="@+id/text_currentlap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="Lap times"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="00:00:00"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/stopwatch_left"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_continue_uninstall"
                android:text="Lap"
                android:textAllCaps="false"
                android:textColor="#08A331" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/stopwatch_main"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keep_phone_tracker"
                android:text="Start"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/stopwatch_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_regular"
                android:text="Lap times"
                android:textColor="@color/home_text_subtitle"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/stopwatch_lap_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="0 completed"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="11sp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/stopwatch_lap_list"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="16dp" />
    </LinearLayout>
</ScrollView>
