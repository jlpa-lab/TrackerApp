<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/compass_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:paddingEnd="8dp"
                android:src="@drawable/ic_phone_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compass"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/home_phone_locator_text"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="0dp">

            <!-- Map icon -->
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Compass"
                android:scaleType="fitCenter"
                android:src="@drawable/tool_compass" />

            <!-- Text section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Find your way with confidence"
                    android:textColor="@color/home_phone_locator_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="Your real-time direction finder"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="11sp" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_compass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/compass_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="45°"
                    android:textColor="#0A1120"
                    android:textSize="36sp"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:id="@+id/compass_direction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="7dp"
                    android:text="NE"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/home_green_background"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/compass_dial_host"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Magnetic north"
                android:textColor="#7D899D"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_compass_details"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Coordinates"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/compass_coordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Waiting for location…"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#0A1120"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Altitude"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/home_text_subtitle"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/compass_altitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="#0A1120"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sensor accuracy"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/home_text_subtitle"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/compass_accuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● High"
                android:paddingVertical="0dp"
                android:textColor="@color/home_green_background"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compass_calibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
                android:background="@drawable/bg_compass_calibrate"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_compass_locate_fixed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Calibrate Compass"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/white"
                android:textSize="12sp" />
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_compass_tip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_phone_info"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="Move your phone in a figure eight to calibrate. Keep away from magnets and metal."
                android:textColor="@color/home_text_subtitle"
                android:textSize="10sp"
                android:fontFamily="@font/inter_regular"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
    <FrameLayout
        android:id="@+id/fr_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black">

        <include
            android:id="@+id/include_banner"
            layout="@layout/layout_banner_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>
</LinearLayout>
