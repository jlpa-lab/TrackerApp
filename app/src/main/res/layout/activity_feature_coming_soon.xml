<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical"
    android:padding="24dp" android:background="@android:color/white">
    <TextView android:id="@+id/feature_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="@color/text_primary"
        android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Coming soon"
        android:textColor="@color/text_primary" android:textSize="18sp" />
</LinearLayout>
