    <LinearLayout android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_nav_settings"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Setting" android:textColor="@color/home_nav_inactive" android:textSize="15sp"/></LinearLayout>
</LinearLayout>
