<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_bot_icon" />
    <!--    <View android:layout_width="match_parent" android:layout_height="480dp" android:background="@drawable/bg_splash_fade" />-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="132dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_bot_icon" />

        <Space
            android:layout_width="1dp"
            android:layout_height="48dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="Lumora "
                android:textColor="#FFE2E2E2"
                android:textSize="57sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="AI"
                android:textColor="#FFCFBDFF"
                android:textSize="57sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:text="Unleash Your Imagination."
            android:textColor="#B3CBC3D7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="1dp"
            android:layout_height="64dp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="260dp"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFCFBDFF" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="INITIALIZING ENGINE..."
            android:textAllCaps="true"
            android:textColor="#FFCFBDFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
