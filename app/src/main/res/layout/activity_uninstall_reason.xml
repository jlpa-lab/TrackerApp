<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>
<LinearLayout
    android:id="@+id/uninstall_reason_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingHorizontal="0dp">

    <include layout="@layout/view_uninstall_toolbar" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="105dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/uninstall_reason_art" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:includeFontPadding="false"
        android:text="@string/uninstall_sorry_title"
        android:textColor="#101114"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/uninstall_question"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <RadioGroup
        android:id="@+id/uninstall_reason_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp">

        <RadioButton
            android:id="@+id/reason_feature"
            style="@style/UninstallReasonOption"
            android:checked="true"
            android:tag="feature_not_working"
            android:text="@string/reason_feature" />

        <RadioButton
            android:id="@+id/reason_ads"
            style="@style/UninstallReasonOption"
            android:tag="too_many_ads"
            android:text="@string/reason_ads" />

        <RadioButton
            android:id="@+id/reason_not_needed"
            style="@style/UninstallReasonOption"
            android:tag="not_needed"
            android:text="@string/reason_not_needed" />

        <RadioButton
            android:id="@+id/reason_other"
            style="@style/UninstallReasonOption"
            android:tag="other"
            android:text="@string/reason_other" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancel_button"
            style="@style/UninstallSecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/uninstall_button"
            style="@style/UninstallPrimaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/uninstall" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- CHANGE: this container is measured against the full screen width. -->
    <FrameLayout
        android:id="@+id/fr_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/shimmer_ads"
            layout="@layout/layout_shimmer_native_medium" />
    </FrameLayout>
</LinearLayout>
</layout>
