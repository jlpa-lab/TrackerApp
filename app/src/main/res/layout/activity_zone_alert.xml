<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F6FBF8"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/zone_back" android:layout_width="28dp" android:layout_height="34dp" android:src="@drawable/ic_phone_back" android:contentDescription="Back"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Zone Alert" android:textSize="25sp" android:textStyle="bold" android:textColor="#111827"/></LinearLayout>
 <TextView android:id="@+id/zone_status_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Set up your safe zones" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/zone_status_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 zones · Ready when you are" android:textColor="#00A44C"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="12dp"><com.google.android.gms.maps.MapView android:id="@+id/zone_map" android:layout_width="match_parent" android:layout_height="match_parent"/><TextView android:id="@+id/zone_map_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="12dp" android:padding="10dp" android:text="Enable location to see zones near you" android:background="#FFFFFF"/></FrameLayout>
 <TextView android:id="@+id/zone_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="0 zones"/><LinearLayout android:id="@+id/zone_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 <Button android:id="@+id/zone_add" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="Add a new zone"/>
 </LinearLayout></ScrollView>
