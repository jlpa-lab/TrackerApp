<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://android.com">
    <!-- State when the switch is ON (Checked) -->
    <item android:state_checked="true" android:color="@color/app_color" />

    <!-- State when the switch is OFF (Unchecked) -->
    <item android:state_checked="false" android:color="#DFE9E3" />
</selector>